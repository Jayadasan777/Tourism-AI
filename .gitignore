# ========================================
# Smart Tour AI - Git Ignore
# ========================================

# CRITICAL: Never commit these files!
# Environment variables and secrets
.env
.env.local
.env.*.local
*.env

# Firebase credentials (CONTAINS PRIVATE KEYS!)
**/serviceAccountKey.json
**/firebase-adminsdk-*.json
firebase-debug.log
.firebase/

# API Keys and secrets
secrets/
credentials/

# ========================================
# Node.js / Backend
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/
*.lcov
.nyc_output

# Build outputs
dist/
build/
*.tsbuildinfo

# ========================================
# Frontend (React/Vite)
# ========================================
# Dependencies
frontend/node_modules/

# Build outputs
frontend/dist/
frontend/build/

# Vite cache
.vite/
frontend/.vite/

# ========================================
# IDEs and Editors
# ========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# ========================================
# Operating System
# ========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ========================================
# Testing
# ========================================
.nyc_output/
coverage/

# ========================================
# Temporary Files
# ========================================
*.tmp
*.temp
*.cache
.cache/
temp/
tmp/

# ========================================
# Database
# ========================================
*.db
*.sqlite
*.sqlite3

# ========================================
# DO NOT IGNORE (Keep these)
# ========================================
# We want these templates in git:
!.env.example
!.gitignore
!README.md
