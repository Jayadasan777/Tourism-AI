# Server Configuration
PORT=5000
NODE_ENV=development

# Firebase Admin SDK (Download from Firebase Console > Project Settings > Service Accounts)
# Path to your firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Google Gemini API (Get from: https://ai.google.dev)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API (Get from: https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Foursquare Places API (Get from: https://foursquare.com/developers/apps)
# Free tier: 100,000 calls/month
FOURSQUARE_API_KEY=your_foursquare_api_key_here

# CORS Settings
FRONTEND_URL=http://localhost:5173
