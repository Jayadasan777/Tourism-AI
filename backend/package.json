{
  "name": "smart-tour-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for Smart Tour AI - SIH 2026",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node scripts/check-setup.js",
    "prestart": "node scripts/check-setup.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:init": "node scripts/init-firebase-database.js",
    "db:collect": "node scripts/collect-district-data.js",
    "db:collect-all": "node scripts/collect-district-data.js all",
    "db:stats": "node -e \"require('./services/tamilNaduDbService').getDatabaseStats().then(s => console.log(s)).then(() => process.exit(0))\""
  },
  "keywords": [
    "tourism",
    "AI",
    "travel",
    "safety"
  ],
  "author": "Team Black Forge",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "joi": "^17.12.0",
    "puppeteer": "^25.9.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
